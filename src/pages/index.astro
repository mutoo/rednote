---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../data/tools';

const madeByMeCount = tools.filter((tool) => tool.madeByMe).length;
---

<Layout>
  <div class="page-shell">
    <header class="site-header">
      <a class="brand" href="/" aria-label="mutoo 的工具收藏夹首页">
        <span class="brand-mark"><Icon name="bookmark" size={23} /></span>
        <span class="brand-name">mutoo<span class="brand-dot">.</span><span class="brand-divider"></span><span class="brand-caption">工具收藏夹</span></span>
      </a>
      <span class="header-note"><span class="rednote-mark">小红书</span><span>里分享，<span class="desktop-word">在</span>这里找到</span><Icon name="arrow" size={15} /></span>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <div class="eyebrow"><span></span> A SMALL COLLECTION, MADE WITH CARE</div>
          <h1 id="hero-heading">好用的<span class="title-star" aria-hidden="true">✳</span>，<br /><span class="highlight">都想分享给你<svg viewBox="0 0 390 14" preserveAspectRatio="none" aria-hidden="true"><path d="M3 10C93 2 268 1 386 6M48 12c98-6 222-6 316-3" /></svg></span>。</h1>
          <p class="hero-description">把亲手做的、亲自用过的小工具，收进这个角落。<br class="desktop-break" />希望也能帮你省点时间，让日常轻松一点。</p>
          <a class="hero-link" href="#collection">来，翻翻我的收藏夹<Icon name="arrow" size={17} /></a>
        </div>

        <div class="hero-illustration" aria-hidden="true">
          <span class="illustration-spark spark-one">✧</span>
          <span class="illustration-spark spark-two">✦</span>
          <div class="folder-back"></div>
          <div class="folder-paper paper-back"><span></span><span></span><span></span></div>
          <div class="folder-paper paper-front"><Icon name="bookmark" size={22} /><span>worth keeping.</span><i></i><i></i></div>
          <div class="folder-front">
            <span class="folder-tab"></span>
            <div class="folder-label"><span>THE GOOD STUFF</span><strong>一些小工具<br />一点小确幸<span>☻</span></strong><span class="folder-label-bottom">COLLECTED BY MUTOO</span></div>
            <span class="folder-sticker"><Icon name="heart" size={17} /></span>
          </div>
          <div class="illustration-caption"><svg width="48" height="33" viewBox="0 0 48 33" fill="none"><path d="M43 3c-2 16-13 24-33 19m4-6-7 5 5 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg><span>我的互联网小抽屉</span></div>
        </div>
      </section>

      <section class="collection" id="collection" aria-labelledby="collection-heading">
        <div class="collection-heading-row">
          <div class="collection-title-group">
            <h2 id="collection-heading">打开收藏夹<span class="collection-total">{String(tools.length).padStart(2, '0')}</span></h2>
            <p>不贪多，每一个都想认真推荐。</p>
          </div>
          <div class="search-box" hidden data-search-box>
            <Icon name="search" size={18} />
            <label class="sr-only" for="tool-search">搜索工具、关键词</label>
            <input id="tool-search" type="search" placeholder="找找你需要的小工具…" autocomplete="off" maxlength="100" />
            <button class="clear-search" type="button" aria-label="清空搜索" hidden><Icon name="close" size={15} /></button>
            <kbd aria-hidden="true">/</kbd>
          </div>
        </div>

        <div class="collection-toolbar" hidden data-toolbar>
          <div class="filters" role="group" aria-label="筛选工具">
            <button class="filter-button is-active" type="button" data-filter="all" aria-pressed="true"><Icon name="grid" size={15} />全部工具<span>{tools.length}</span></button>
            <button class="filter-button" type="button" data-filter="made" aria-pressed="false"><Icon name="code" size={16} />我做的<span>{madeByMeCount}</span></button>
            <button class="filter-button" type="button" data-filter="saved" aria-pressed="false"><Icon name="bookmark" size={15} />已收藏<span data-saved-count>0</span></button>
          </div>
          <span class="collection-status"><span></span> 持续发现，慢慢更新</span>
        </div>

        <div class="tools-grid" data-tools-grid>
          {tools.map((tool, index) => <ToolCard tool={tool} index={index} />)}

          <aside class="coming-soon" data-coming-soon>
            <div class="little-flower" aria-hidden="true">
              <svg width="82" height="100" viewBox="0 0 82 100" fill="none"><path d="M41 91V52m0 28c-16 0-23-9-24-16 14-2 23 5 24 16Zm0-10c15 0 21-10 22-17-13-1-21 7-22 17Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M31 29c-12-17 0-26 10-12 10-14 22-5 10 12 21-2 23 13 5 16 7 19-7 26-15 8-9 18-23 11-15-8C8 42 10 27 31 29Z" fill="#e7ebd7" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="41" cy="35" r="8" fill="#f8f8f2" stroke="currentColor" stroke-width="1.5"/><path d="M38.5 35h.1m4.9 0h.1M39 38c1.2 1 2.8 1 4 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <span class="coming-soon-eyebrow">LEAVE ROOM FOR GOOD THINGS</span>
            <h3>下一个好工具，<br />正在路上。</h3>
            <p>收藏夹还很小，日子还很长。<br />遇到好用的，就继续放进来。</p>
            <span class="coming-soon-bottom"><Icon name="plus" size={14} /> 留一点位置给惊喜</span>
          </aside>
        </div>

        <div class="empty-state" data-empty-state hidden>
          <span class="empty-icon"><Icon name="search" size={27} /></span>
          <h3 data-empty-title>还没找到这个工具</h3>
          <p data-empty-description>换个关键词试试，比如「澳洲」或「8558」。</p>
          <button class="reset-button" type="button" data-reset>看看全部工具<Icon name="arrow" size={16} /></button>
        </div>
        <p class="sr-only" data-results-status role="status" aria-live="polite" aria-atomic="true"></p>
        <p class="collection-footnote"><Icon name="leaf" size={14} /><span>小小的工具，解决具体的小问题。</span><span class="footnote-line"></span><span class="footnote-english">LESS FRICTION, MORE LIVING.</span></p>
      </section>
    </main>

    <footer class="site-footer">
      <p>用一点好奇心，做一点有用的东西。<span class="footer-heart" aria-label="用心制作">♡</span></p>
      <span>© {new Date().getFullYear()} mutoo <span class="footer-dot">·</span> 慢慢收集，常常分享</span>
    </footer>
  </div>
  <div class="toast" role="status" aria-live="polite" aria-atomic="true" data-toast></div>
</Layout>

<script>
  import '../scripts/collection';
</script>
